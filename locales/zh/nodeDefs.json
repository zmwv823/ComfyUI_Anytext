            "font_name": {
                "name": "字体名字"
            },
            "mode": {
                "name": "模式"
            },
            "sort_radio": {
                "name": "文字位置排序"
            },
            "random_mask": {
                "name": "随机自动遮罩",
                "tooltip": "启用后自动生成遮罩。"
            },
            "revise_pos": {
                "name": "文字位置调整",
                "tooltip": "使用边界盒子渲染文字作位置调整。但是发现偶尔会影响生成质量，仅在使用随机生成遮罩时生效。"
            },
            "image": {
                "name": "图像"
            },
            "fonts": {
                "name": "AnyText2字体"
            },
            "font_apply": {
                "name": "应用方法"
            }
        },
        "outputs": {
            "0": {
                "name": "正面条件",
                "tooltip": "不适用于ComfyUI原生节点。"
            },
            "1": {
                "name": "负面条件",
                "tooltip": "不适用于ComfyUI原生节点。"
            },
            "2": {
                "name": "图像"
            },
            "3": {
                "name": "图像"
            }
        }
    },

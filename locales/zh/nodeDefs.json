{
    "UL_AnyTextLoader": {
        "description": "加载AnyText模型。",
        "display_name": "AnyText模型加载器",
        "inputs": {
            "ckpt_name": {
                "name": "模型名称"
            },
            "control_net_name": {
                "name": "控制网模型名字",
                "tooltip": "AnyText v1.1或者 v2.0"
            },
            "miaobi_clip": {
                "name": "妙笔文本编码器"
            },
            "weight_dtype": {
                "name": "数据类型"
            },
            "init_device": {
                "name": "初始加载模型设备"
            }
        },
        "outputs": {
            "0": {
                "name": "AnyText模型"
            },
            "2": {
                "name": "路径",
                "tooltip": "模型路径。"
            }
        }
    },
    "UL_AnyTextSampler": {
        "description": "AnyText模型采样。",
        "display_name": "AnyText采样",
        "inputs": {
            "model": {
                "name": "AnyText模型"
            },
            "positive": {
                "name": "正面条件"
            },
            "negative": {
                "name": "负面条件"
            },
            "steps": {
                "name": "步数"
            },
            "strength": {
                "name": "控制网强度"
            },
            "attnx_scale": {
                "name": "注意力强度"
            },
            "keep_load": {
                "name": "模型保活",
                "tooltip": "注意：仅在这个节点不再需要时卸载模型，将尽量尝试释放模型占用的系统内存和设备专用内存。如果卸载后想继续使用此节点，使用ComfyUI-Manager插件的`Free model and node cache`重置节点状态或者更改模型加载节点的参数或者替换加载节点(建议)来激活。"
            },
            "keep_device": {
                "name": "保活设备",
                "tooltip": "生图完成后，在支持的设备上，模型移动到comfy自动选择设备(HIGH_VRAM: device, 其他: cpu)或者保留在设备专用内存上。"
            }
        },
        "outputs": {
            "0": {
                "name": "latent",
                "tooltip": "图像潜空间。"
            }
        }
    },
    "UL_AnyTextEncoder": {
        "description": "AnyText编码。",
        "display_name": "AnyText编码",
        "inputs": {
            "model": {
                "name": "AnyText模型"
            },
            "mask": {
